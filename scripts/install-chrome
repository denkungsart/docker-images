#!/bin/bash
set -xeo pipefail

apt-get update
apt-get install -y --no-install-recommends curl ca-certificates unzip

if [[ "${TARGETPLATFORM}" == "linux/amd64" ]]; then
  # Google Chrome stable, plus the Chrome for Testing chromedriver for the same build
  # ref https://github.com/GoogleChromeLabs/chrome-for-testing#json-api-endpoints
  curl -fsSL -o /tmp/google-chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
  apt-get install -y --no-install-recommends /tmp/google-chrome.deb
  rm /tmp/google-chrome.deb

  CHROME_BUILD="$(google-chrome --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)"
  CHROMEDRIVER_VERSION="$(curl -fsSL "https://googlechromelabs.github.io/chrome-for-testing/LATEST_RELEASE_${CHROME_BUILD}")"
  curl -fsSL -o /tmp/chromedriver.zip \
    "https://storage.googleapis.com/chrome-for-testing-public/${CHROMEDRIVER_VERSION}/linux64/chromedriver-linux64.zip"
  unzip -j /tmp/chromedriver.zip chromedriver-linux64/chromedriver -d /usr/local/bin
  rm /tmp/chromedriver.zip
else
  # Google does not publish Linux arm64 builds of Chrome; use Debian's Chromium instead
  apt-get install -y --no-install-recommends chromium chromium-driver
  ln -sf /usr/bin/chromium /usr/local/bin/google-chrome
fi

apt-get clean
rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

google-chrome --version
chromedriver --version
